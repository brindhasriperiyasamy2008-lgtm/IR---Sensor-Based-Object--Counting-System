  WebServer server(80);
  const char* MCU = "ESP32";
#else
  #include <ESP8266WiFi.h>
  #include <ESP8266WebServer.h>
  ESP8266WebServer server(80);
  const char* MCU = "ESP8266";
  #ifndef IRAM_ATTR
    #define IRAM_ATTR ICACHE_RAM_ATTR
  #endif
#endif

