const unsigned long DEBOUNCE_MS = 200;

unsigned long total = 0;
unsigned long lastHit = 0;
unsigned long lastDetection = 0;
bool debounceOn = true;
int previousSensorState = HIGH;
LiquidCrystal_I2C lcd(0x27, 16, 2);

