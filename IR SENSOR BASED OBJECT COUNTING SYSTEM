<script>
(()=>{
const $=id=>document.getElementById(id),N=12;
let total=0,chg=0,deb=true,live=false,seen=0,lastT=null,up=0,startT=Date.now(),stamps=[];
let target=Number(localStorage.getItem('irTarget')||0),targetAlerted=false;
const buckets=new Array(N).fill(0);
const bars=$('bars');for(let i=0;i<N;i++){const b=document.createElement('div');b.className='bar';bars.appendChild(b)}

function drawBars(){const m=Math.max(4,...buckets);[...bars.children].forEach((b,i)=>b.style.height=Math.max(3,buckets[i]/m*100)+'%')}
function updateTarget(){
  const input=$('targetInput');
  const card=$('targetCard');
  const fill=$('progressFill');
  const status=$('targetStatus');
  if(target>0) input.value=target;
  if(!target){fill.style.width='0%';status.textContent='Set a target to start monitoring';card.classList.remove('dangerCard');return;}
  const pct=Math.min(100,Math.round(total/target*100));
  fill.style.width=pct+'%';
  if(total>=target){
    status.innerHTML='🚨 TARGET REACHED! <span class="targetDone">'+total+' / '+target+'</span> · Production completed';
    status.classList.add('danger');card.classList.add('dangerCard');
    if(!targetAlerted){targetAlerted=true;try{alert('🚨 TARGET REACHED!\n\nTarget: '+target+' objects\nCurrent count: '+total);}catch(e){}}
  }else{
    status.textContent=total+' / '+target+' objects · '+pct+'% completed';
    status.classList.remove('danger');card.classList.remove('dangerCard');targetAlerted=false;
  }
}
$('targetBtn').onclick=()=>{const v=parseInt($('targetInput').value,10);if(!v||v<1){alert('Please enter a valid target count.');return;}target=v;targetAlerted=false;localStorage.setItem('irTarget',target);updateTarget();};
$('resetTarget').onclick=()=>{target=0;targetAlerted=false;localStorage.removeItem('irTarget');$('targetInput').value='';updateTarget();};
$('targetInput').addEventListener('keydown',e=>{if(e.key==='Enter')$('targetBtn').click()});

function stats(){
  const now=Date.now();stamps=stamps.filter(t=>now-t<60000);
  $('total').textContent=total.toLocaleString();$('chg').textContent=chg;
  $('perMin').textContent=stamps.length;
  const secs=live?Math.max(up,30):Math.max((now-startT)/1000,30);
  $('rate').textContent=Math.round(chg/secs*3600);
  if(lastT){const s=Math.floor((now-lastT)/1000);$('last').textContent=s<60?s+'s':Math.floor(s/60)+'m'}
  $('clock').textContent=new Date().toLocaleTimeString([],{hour12:false});
  updateTarget();
}
function detect(force){
  const now=Date.now();
  if(!force&&deb&&lastT&&now-lastT<500)return;
  lastT=now;total++;chg++;stamps.push(now);buckets[N-1]++;
  const tr=document.createElement('tr');tr.className='new';
  tr.innerHTML='<td>#IR-'+total+'</td><td>'+new Date().toLocaleTimeString([],{hour12:false})+'</td><td>IR Sensor 01</td><td><span class="tag">DETECTED</span></td>';
  $('ev').prepend(tr);while($('ev').rows.length>6)$('ev').lastElementChild.remove();
  const h=$('hero');h.classList.remove('pop');void h.offsetWidth;h.classList.add('pop');
  const bx=$('box');bx.classList.remove('go');void bx.offsetWidth;bx.classList.add('go');
  setTimeout(()=>{$('scene').classList.add('hit');$('bstat').textContent='Beam broken!';$('bstat').className='bstat hit'},560);
  setTimeout(()=>{$('scene').classList.remove('hit');$('bstat').textContent='Beam clear';$('bstat').className='bstat ok'},900);
  drawBars();stats();
}
$('sim').onclick=()=>detect();
$('tog').onclick=()=>{deb=!deb;$('tog').classList.toggle('off',!deb);$('dlbl').textContent=deb?'Enabled · ignores repeats':'Disabled · every break counts';if(live)fetch('/debounce?on='+(deb?1:0)).catch(()=>{})};

setInterval(()=>{buckets.shift();buckets.push(0);drawBars()},5000);
setInterval(stats,1000);

// Demo mode: random objects until the ESP board answers
(function demo(){if(!live)detect();setTimeout(demo,1200+Math.random()*2800)})();
for(let i=0;i<4;i++)buckets[N-1-i]=Math.floor(Math.random()*4)+1;
drawBars();updateTarget();stats();

// Live mode: the ESP board serves this page and answers GET /data
async function poll(){
  const t0=performance.now();let j;
  try{j=await(await fetch('/data',{cache:'no-store'})).json();if(typeof j.count!=='number')throw 0}catch(e){if(live){$('link').textContent='Connection lost'}return}
  if(!live){live=true;total=seen=j.count;chg=0;stamps=[];buckets.fill(0);$('ev').innerHTML='';
    $('totalLbl').textContent='Objects counted since power-on';$('sim').hidden=true;
    $('foot').textContent='Live data from your IR sensor · Brindha Sri, Devadharshini & Dhanyasri';
    if(j.mcu)$('mcu').textContent=j.mcu;if(deb!==!!j.deb)$('tog').click()}
  $('link').textContent='Sensor connected';
  if(j.count<seen){total=seen=j.count;chg=0}
  for(let n=j.count-seen;n>0;n--)detect(true);
  seen=j.count;up=j.up;lastT=j.count?Date.now()-j.ago*1000:null;
  $('upt').textContent=String(Math.floor(up/3600)).padStart(2,'0')+'h '+String(Math.floor(up%3600/60)).padStart(2,'0')+'m';
  $('rtt').textContent=Math.round(performance.now()-t0)+' ms';stats();
}
if(location.protocol.startsWith('http'))(async function loop(){await poll();setTimeout(loop,live?500:5000)})();
})();
</script></body></html>
)rawliteral";

void handleData() {
  unsigned long n = total, up = millis() / 1000;
  long ago = n ? (long)((millis() - lastHit) / 1000) : -1;
  char buf[112];
  snprintf(buf, sizeof(buf), "{\"count\":%lu,\"ago\":%ld,\"up\":%lu,\"deb\":%d,\"mcu\":\"%s\"}",
           n, ago, up, debounceOn ? 1 : 0, MCU);
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", buf);
}

void setup() {
  Serial.begin(115200);
  pinMode(IR_PIN, INPUT);

  Wire.begin();
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("Object Counter");
  lcd.setCursor(0, 1);
  lcd.print("Count: 0");

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  while (WiFi.status() != WL_CONNECTED) { delay(300); Serial.print('.'); }
  Serial.print("\nDashboard: http://");
  Serial.println(WiFi.localIP());

  server.on("/", []() { server.send_P(200, "text/html", INDEX_HTML); });
  server.on("/data", handleData);
  server.on("/debounce", []() { debounceOn = server.arg("on") != "0"; server.send(200, "text/plain", "ok"); });
  server.begin();
}

void loop() {
  server.handleClient();

  int sensorState = digitalRead(IR_PIN);
  unsigned long now = millis();

  // Count once when the active-LOW sensor changes from HIGH to LOW.
  if (sensorState == LOW && previousSensorState == HIGH) {
    if (!debounceOn || lastDetection == 0 || now - lastDetection >= DEBOUNCE_MS) {
      total++;
      lastHit = now;
      lastDetection = now;

      lcd.setCursor(0, 1);
      lcd.print("Count: ");
      lcd.print(total);
      lcd.print("     ");

      Serial.print("Count: ");
      Serial.println(total);
    }
  }

  previousSensorState = sensorState;
  delay(10);
}
